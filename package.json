{
  "name": "dsh-ark-plans",
  "version": "0.3.0",
  "description": "Volcengine Ark (火山方舟) Agent Plan and Coding Plan model routes for DeepSeek Harness: two ready provider profiles declared on the shipped llm-pi-ai adapter, a session-header pill showing each plan's remaining allowance and when it next refreshes, and a Settings page that enables or disables individual models in the model selector.",
  "type": "module",
  "license": "MIT",
  "author": "HaydenSmith1121",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaydenSmith1121/dsh-ark-plans.git"
  },
  "homepage": "https://github.com/HaydenSmith1121/dsh-ark-plans#readme",
  "bugs": {
    "url": "https://github.com/HaydenSmith1121/dsh-ark-plans/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-catalog.mjs && node scripts/test-selection.mjs && node scripts/test-client-bundle.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "volcengine",
    "ark",
    "火山方舟",
    "agent-plan",
    "coding-plan",
    "quota",
    "model-selection",
    "llm",
    "cordis"
  ]
}
